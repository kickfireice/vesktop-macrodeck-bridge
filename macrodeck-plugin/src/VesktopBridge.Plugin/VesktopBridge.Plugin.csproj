<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DeckBridge.Plugin</AssemblyName>
    <RootNamespace>DeckBridge.Plugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MacroDeck.Plugin.Hosting" Version="3.0.0-beta.15" />
    <PackageReference Include="MacroDeck.Plugin.Serilog" Version="3.0.0-beta.15" />
    <PackageReference Include="MacroDeck.Plugin.Analyzers" Version="3.0.0-beta.15" PrivateAssets="all" />
    <ProjectReference Include="..\VesktopBridge.Core\VesktopBridge.Core.csproj" />
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
