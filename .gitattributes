# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Windows-only build/CI scripts keep CRLF so they run as-is on Windows.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Shell scripts must keep LF everywhere - CRLF breaks the #! line on Linux.
*.sh    text eol=lf
# CI workflows must keep LF - CRLF breaks shell steps on Linux runners.
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets - never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
*.dll   binary
